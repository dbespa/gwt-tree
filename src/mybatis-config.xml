<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <environments default="development">
        <environment id="development">
            <transactionManager type="JDBC" />
            <dataSource type="POOLED">
                <property name="driver"
                    value="org.postgresql.Driver" />
                <property name="url"
                    value="jdbc:postgresql://localhost:5432/postgres" />
                <property name="username" value="postgres" />
                <property name="password" value="pgpwd4" />

                <property name="poolMaximumActiveConnections"
                    value="20" />
                <property name="poolMaximumIdleConnections"
                    value="5" />
                <property name="poolMaximumCheckoutTime"
                    value="20000" />
                <property name="poolPingQuery" value="SELECT 1" />
                <property name="poolPingEnabled" value="true" />
            </dataSource>
        </environment>
    </environments>

    <mappers>
        <mapper
            resource="com/example/myapp/server/mapper/NodeMapper.xml" />
    </mappers>
</configuration>