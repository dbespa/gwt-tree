@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(person, "Пользователь", "Использует веб-приложение")
System_Boundary(c1, "") {
    Container(browser, "Браузер")
    Container(server, "Сервер")
    ContainerDb(db, "База Данных")
}

Rel(person, browser, "Использует")
Rel(browser, server, "GET RPC")
Rel(server, db, "Reads from")

@enduml
