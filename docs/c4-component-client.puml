@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(person, "Пользователь", "Использует веб-приложение")
System_Boundary(c1, "") {
    Container(widget, "NodeTableWidget")
    Container(refreshService, "NodeTableRefreshService")
    Container(rpcService, "NodeRpcService")
}
Container(server, "Сервер")
ContainerDb(db, "База Данных")

Rel(person, widget, "Использует")

Rel(widget, refreshService, "Вызывает")
Rel(refreshService, rpcService, "Вызывает")

Rel(rpcService, server, "GET RPC")
Rel(server, db, "Reads from")

@enduml
