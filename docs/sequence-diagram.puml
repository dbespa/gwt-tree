@startuml
actor "Пользователь" as user
box "Клиентская часть"
participant "Браузер" as browser
participant "NodeTableWidget" as widget
participant "NodeTableRefreshService" as refreshService
participant "NodeRpcService" as rpcService
box end
box "Серверная часть"
participant "NodeRpcServiceImpl" as rpcServiceImpl
participant "NodeConvertor" as converter
participant "NodeDao" as dao
database "База данных" as db
box end

group Открытие приложения

user -> browser++:start()
activate user
browser -> widget++:getTreeWidget()
widget -> refreshService++:getAllNodes(void)
refreshService -> rpcService++:getAllNodes(void)
rpcService ->> rpcServiceImpl++:getAllNodes(void)
rpcServiceImpl -> dao++:getAllNodes(void)
dao -> db++:getAllNodes(void)

db -->> dao--:List<NodeEntity>
dao -->> converter--:List<NodeEntity>
activate converter
converter -> converter: convertToNodeBeanList(allNodes)
converter -->> rpcServiceImpl--:List<NodeBean>
rpcServiceImpl -->> rpcService--:List<NodeBean>
rpcService -->> refreshService--:List<NodeBean>
refreshService -->> widget--:List<NodeBean>
widget -->> browser--:TreeWidget
browser -->> user--:Отрисованная страница
deactivate user

end

group Обновление списка узлов

user -> browser++:клик на кнопку "Refresh"
activate user
browser -> widget++:getTreeWidget()
widget -> refreshService++:getAllNodes(void)
refreshService -> rpcService++:getAllNodes(void)
rpcService ->> rpcServiceImpl++:getAllNodes(void)
rpcServiceImpl -> dao++:getAllNodes(void)
dao -> db++:getAllNodes(void)

db -->> dao--:List<NodeEntity>
dao -->> converter--:List<NodeEntity>
activate converter
converter -> converter: convertToNodeBeanList(allNodes)
converter -->> rpcServiceImpl--:List<NodeBean>
rpcServiceImpl -->> rpcService--:List<NodeBean>
rpcService -->> refreshService--:List<NodeBean>
refreshService -->> widget--:List<NodeBean>
widget -->> browser--:TreeWidget
browser -->> user--:Отрисованная страница
deactivate user

end

@enduml
